#!/bin/bash
# .githooks/pre-commit
# 架構自動化守門員，阻擋不合規的提交

echo "[Pre-commit Hook] 🛡️ 啟動 Architecture Linter 驗證..."

# 嚴格遵照 NotebookLM 指示：必須使用 -File 而非 -Command，確保 Exit Code 正確回傳
powershell.exe -ExecutionPolicy Bypass -File "./verify_architecture.ps1"

# 捕捉 PowerShell 腳本的回傳碼
if [ $? -ne 0 ]; then
    echo ""
    echo "================================================================"
    echo "❌ [Pre-commit Hook] 攔截！Architecture 驗證失敗 (Task Failed)。"
    echo "請修正架構違規後再行提交。"
    echo "================================================================"
    exit 1
fi

echo "✅ [Pre-commit Hook] Architecture 驗證通過。"

echo "[Pre-commit Hook] 🛡️ 啟動 SOP Linter 驗證..."
node ./.githooks/sop_linter.js
if [ $? -ne 0 ]; then
    exit 1
fi

echo "✅ [Pre-commit Hook] 全部驗證通過，允許提交。"
exit 0
