# ══════════════════════════════════════════════════
# 個人工作站環境設定範本
# 請複製本檔案為 .env.local 並填入實際金鑰
# .env.local 永遠不會上傳 GitHub（.gitignore 已保護）
# 換新電腦時執行：node scripts/setup_env.js
# ══════════════════════════════════════════════════

# 資料庫
DATABASE_URL=

# 應用程式
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LINE Bot
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ALLOWED_USER_ID=

# 隧道
TUNNEL_URL=

# 外部服務
GITHUB_TOKEN=
NOTION_TOKEN=
FINMIND_API_TOKEN=

# 內部安全金鑰（使用 PowerShell 產生：
# [System.Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(24))）
INTERNAL_GATEWAY_TOKEN=
CURRENT_AGENT_SECRET=
NEXT_AGENT_SECRET=
CURRENT_OUTBOX_SECRET=
NEXT_OUTBOX_SECRET=
CURRENT_SECRET_VERSION=1.0
AGENT_SECRET_VERSION=1.0
